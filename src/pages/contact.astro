---
import {
  getRankedPosts,
  getAllTags,
} from '../lib/notion/client.ts'
import Layout from '../layouts/Layout.astro'
import BlogTagsLink from '../components/BlogTagsLink.astro'
import styles from '../styles/blog.module.css'

const [rankedPosts, tags] = await Promise.all([
  getRankedPosts(),
  getAllTags(),
])
---

<Layout title="お問い合わせ" description="ご意見・ご質問・ビジネスのご依頼はこちらからどうぞ。" path="/contact">
  <div slot="main" class={styles.main}>
    <header>
      <h2>お問い合わせ</h2>
      <p>ご意見・ご質問・ビジネスのご依頼はこちらからお気軽にどうぞ。<br />内容を確認のうえ、メールにてご返信します。</p>
    </header>

    <div class="form-wrapper">
      <iframe
        src="https://docs.google.com/forms/d/e/1FAIpQLSebnm4Q7Wlvg6xgLqDEdrmJwyiq0qy1GV7acqJYqNZalRPWhw/viewform?embedded=true"
        width="640"
        height="1100"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        loading="lazy"
      >
        読み込んでいます…
      </iframe>
    </div>
  </div>

  <div slot="aside" class={styles.aside}>
    <BlogTagsLink heading="タグ" tags={tags} />
  </div>
</Layout>

<style>
  header {
    padding: 0 0 24px;
  }
  header h2 {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  header p {
    color: #555;
    font-size: 0.95rem;
    line-height: 1.8;
    margin: 0;
  }
  .form-wrapper {
    width: 100%;
    overflow-x: hidden;
  }
  .form-wrapper iframe {
    display: block;
    width: 640px;
    max-width: 100%;
  }
</style>
